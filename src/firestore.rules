rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ─── HELPER FUNCTIONS ───────────────────────────────────────────────────
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSystemAdmin() {
      return isSignedIn() && (
        request.auth.token.superadmin == true ||
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }
    
    function getLesson(appId, ownerId, lessonId) {
      return get(/databases/$(database)/documents/artifacts/$(appId)/users/$(ownerId)/lessons/$(lessonId)).data;
    }

    // Returns true when a lesson document allows public (anonymous) read access.
    function isPublicLesson(lessonData) {
      return lessonData.isPublic == true || lessonData.allowLinkAccess == true;
    }

    // The app-layer commentContentSchema (shared/schemas/comment.schema.ts)
    // caps comments at 2000 chars, but that's a client-JS-only check — a
    // caller writing directly with a valid auth token had no server-side
    // backstop at all (T-109a). Rules can't import the TS constant, so this
    // number is a structurally-unavoidable second copy, kept in step by hand.
    function withinCommentSizeLimits(data) {
      return data.content is string && data.content.size() > 0 && data.content.size() <= 2000;
    }

    // ─── NOTIFICATION VALIDATION (Epic 3 — Stage 2) ─────────────────────────
    // Cross-user notification creation is server-only (Admin SDK bypasses
    // rules); clients may only create in their OWN inbox. The helpers below
    // still guard the pending-invite create path (client-written, email-keyed)
    // and the immutability of an existing notification on update.

    function isValidNotificationType(t) {
      return t in ['invite', 'comment', 'reply', 'role_change'];
    }

    function withinNotificationSizeLimits(data) {
      return data.title is string && data.title.size() <= 200
             && data.message is string && data.message.size() <= 2000;
    }

    // Fields that must never change once a notification exists (only read-state
    // and the soft-delete flag may be mutated).
    function notificationImmutableFieldsUnchanged() {
      return request.resource.data.senderId == resource.data.senderId
             && request.resource.data.type == resource.data.type
             && request.resource.data.userId == resource.data.userId
             && request.resource.data.createdAt == resource.data.createdAt;
    }

    // ─── CORE DOMAIN RULES ──────────────────────────────────────────────────

    match /artifacts/{appId} {
      
      match /users/{userId} {
        // User profile and progress
        allow read, write: if isOwner(userId);
        
        match /lessons/{lessonId} {
          // Public decks are readable by anyone (including anonymous users).
          // Role-based access still requires authentication.
          allow read: if isPublicLesson(resource.data)
                      || isOwner(userId)
                      || (isSignedIn() && resource.data.roles[request.auth.uid] != null);
          
          allow create: if isOwner(userId);
          
          // Only owner or explicit editor role may mutate lesson metadata.
          allow update: if isOwner(userId)
                        || (isSignedIn() && resource.data.roles[request.auth.uid] == 'editor');
          
          allow delete: if isOwner(userId);

          // Nesting for deep comments (Path from comment.service.ts)
          match /cards/{cardId}/comments/{commentId} {
            allow read: if isOwner(userId)
                        || isPublicLesson(getLesson(appId, userId, lessonId))
                        || (isSignedIn() && getLesson(appId, userId, lessonId).roles[request.auth.uid] != null);
            
            // Size limit only on create — enforcing it on update too could
            // block an unrelated edit (e.g. resolving a comment) on any
            // already-stored comment that predates this check, which this
            // repo cannot verify doesn't exist (no production data access).
            allow create: if withinCommentSizeLimits(request.resource.data)
                          && (isOwner(userId)
                          || (isSignedIn() && getLesson(appId, userId, lessonId).roles[request.auth.uid] in ['owner', 'editor', 'commenter']));

            allow update, delete: if isOwner(userId)
                                  || (isSignedIn() && request.auth.uid == resource.data.userId)
                                  || (isSignedIn() && getLesson(appId, userId, lessonId).roles[request.auth.uid] == 'editor');
          }
        }
        
        match /cards/{cardId} {
          // Cards are readable when the parent lesson is public or the viewer has a role.
          // Anonymous reads are allowed when the parent lesson is public.
          allow read: if isOwner(userId)
                      || isPublicLesson(getLesson(appId, userId, resource.data.lessonId))
                      || (isSignedIn() && getLesson(appId, userId, resource.data.lessonId).roles[request.auth.uid] != null);
          
          // Only owner or editor may write cards — never from a shared/anonymous context.
          allow write: if isOwner(userId)
                       || (isSignedIn() && getLesson(appId, userId, resource.data.lessonId).roles[request.auth.uid] == 'editor');
        }

        match /notifications/{notiId} {
          allow read: if isOwner(userId);

          // Create: ONLY the inbox owner may write into their own inbox — this
          // covers pending-invite delivery, where the delivering user copies
          // pending items into their OWN notifications (senderId is the original
          // sender, but userId == the writer). Every other cross-user
          // notification is created server-side via the Admin SDK
          // (emitNotificationAction), which bypasses rules — so a client can
          // never create a notification in someone else's inbox.
          allow create: if isOwner(userId);

          // Update: owner only, and only read-state / soft-delete — the sender,
          // type, target, and createdAt of an existing notification are frozen.
          allow update: if isOwner(userId) && notificationImmutableFieldsUnchanged();

          // No hard delete — the app soft-deletes via `isDeleted: true` (update).
        }
        
        match /sharedProgress/{shareId} {
          // Only the viewer who owns this progress document may read or write it.
          allow read, write: if isOwner(userId);
        }

        // Per-mode best scores (Speed/Match/Survival) — stats.service.ts's
        // subscribePersonalBests/recordGameResult/subscribeGameStats and the
        // shared persist-best-score.ts helper all read/write only the caller's
        // own uid, so this is owner-only like sharedProgress above.
        match /stats/{gameMode} {
          allow read, write: if isOwner(userId);
        }
      }

      // ─── PER-CARD SRS PROGRESS ─────────────────────────────────────────────
      // Sibling of users/{userId}, not nested under it — progress.service.ts's
      // userProgressCardDoc()/dailyStatsDoc() write here. Always private to the
      // learner: even when grading a card in a shared deck, the learner's own
      // SRS state lives under their own uid here, never the deck owner's — so,
      // unlike lessons/cards above, there is no public/role-based read case.
      match /userProgress/{userId} {
        allow read, write: if isOwner(userId);

        match /lessons/{lessonId}/cards/{cardId} {
          allow read, write: if isOwner(userId);
        }

        match /studyStats/{statId} {
          allow read, write: if isOwner(userId);
        }
      }

      // ─── PUBLIC GAME DATA (Sessions + Leaderboards) ─────────────────────────
      // Sibling of users/{userId}, not nested under it — session.service.ts's
      // sessionsCol() and leaderboard.service.ts's lbDoc()/subscribeLeaderboard
      // read/write here. Session docs are private bookkeeping the client never
      // reads back (score is also tracked locally); leaderboard entries are the
      // public ranking every player's MiniLeaderboard subscribes to, keyed by
      // the owner's uid as the document ID.
      match /public/data/game_sessions/{sessionId} {
        allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
        allow delete: if false;
      }

      match /public/data/{collectionId}/{userId} {
        allow read: if collectionId.matches('leaderboard_.*');
        allow write: if collectionId.matches('leaderboard_.*') && isOwner(userId);
      }

      // ─── PENDING NOTIFICATIONS (Pre-login invites) ────────────────────────
      
      match /pendingNotifications/{email}/items/{id} {
        // Users can read/delete pending invites sent to their specific email.
        allow read, delete: if isSignedIn() && request.auth.token.email.lower() == email.lower();
        // A signed-in caller may enqueue a pending invite, but cannot forge the
        // sender and must send a well-formed payload. (Stage 2 moves this to
        // server-only creation via the Admin SDK.)
        allow create: if isSignedIn()
                      && request.resource.data.senderId == request.auth.uid
                      && isValidNotificationType(request.resource.data.type)
                      && withinNotificationSizeLimits(request.resource.data);
      }
    }

    // ─── ADMIN & SYSTEM LOGS ───────────────────────────────────────────────

    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /system_logs/{logId} {
      allow read: if isSystemAdmin();
      allow create, update, delete: if false;
    }

    // ─── COLLECTION GROUP QUERIES ───────────────────────────────────────────

    // Enables discovery of shared decks across the global users collection.
    // Public decks are readable without authentication; role-based access requires auth.
    //
    // LDG-22 (2026-08-04): the legacy `collaborators.hasAny(...)` branch was
    // removed — every write path (lesson-save.ts, lesson.service.ts,
    // access.service.ts) has always kept `roles` and `collaborators` in
    // lockstep, so this mirrors the direct-path lesson rule above, which was
    // already roles-only.
    match /{path=**}/lessons/{lessonId} {
      allow read: if resource.data.isPublic == true
                  || resource.data.allowLinkAccess == true
                  || (isSignedIn() && resource.data.roles[request.auth.uid] != null);
    }
  }
}
