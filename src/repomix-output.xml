                        {t("prev")}
                    </Button>
                    <Button
                        alphabet={alphabet}
                        onClick={next}
                        className="flex-1 py-2.5 text-sm md:py-4 md:text-lg"
                    >
                        {t("next")} <ChevronRight size={20} strokeWidth={3} />
                    </Button>
                </div>
            </div>
        </div>
    );
}
