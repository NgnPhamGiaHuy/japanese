    const locale = useLocale();

    return useMemo(
        () => ({
            justNow: t("justNow"),
            minutes: (count: number) => t("minutes", { count }),
            hours: (count: number) => t("hours", { count }),
            days: (count: number) => t("days", { count }),
            locale,
        }),
        [t, locale],
    );
}
