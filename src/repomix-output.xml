    src?: string | null;
    /** Whether the user is currently in an active state. */
    active: boolean;
    /** Tailwind text color class for the active indicator. */
    activeColor?: string;
    /** Diameter of the avatar in pixels. */
    size?: number;
}

/**
 * Circular user profile image with activity status.
 *
