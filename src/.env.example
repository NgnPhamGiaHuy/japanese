# =============================================================================
# Environment contract — copy to `.env.local` and fill in.
#
#   cp .env.example .env.local
#
# Every variable the code reads is listed here. Most integrations are
# *env-gated no-ops*: when a value is missing they disable themselves quietly
# rather than failing, which is convenient in dev and invisible in production.
# So each entry states its OBSERVABLE DEGRADATION — what actually stops working
# when it is unset — because that is the part you cannot discover by watching
# the app start successfully.
#
# NEVER commit real values. This file holds names, shapes and defaults only.
# `.gitignore` ignores `.env*` and re-includes this one file explicitly.
#
# Minimum to run `npm run dev`: the six NEXT_PUBLIC_FIREBASE_* values.
# Everything else has a working default or degrades silently.
# =============================================================================


# --- Firebase client SDK -----------------------------------------------------
# REQUIRED. Read at module load in lib/firebase.ts. There is no fallback: with
# the API key missing, getAuth() throws `auth/invalid-api-key` during import and
# the app does not boot. Values are public by design — they ship in the client
# bundle, and access is controlled by Firestore rules, not by their secrecy.
# Source: Firebase console → Project settings → Your apps → SDK setup.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=


# --- Firebase Admin SDK (server only) ----------------------------------------
# Required for every server action: admin reads, notification writes, audit
# logging, token verification. lib/firebase-admin.ts wraps these in lazy Proxy
# singletons, so `next build` succeeds WITHOUT them — the failure surfaces at
# request time, not build time. Degradation: server actions reject; the UI shows
# generic failures while the build and the dev server look healthy.
#
# PRIVATE_KEY is a real secret. Keep the surrounding quotes and the literal \n
# escapes exactly as the service-account JSON provides them.
# Source: Firebase console → Project settings → Service accounts → Generate key.

FIREBASE_ADMIN_PROJECT_ID=your-project
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"


# --- Firestore namespace root ------------------------------------------------
# All app data lives under `artifacts/{APP_ID}/…`. Two variables derive this
# value in two packages, and THEY MUST AGREE: if they diverge, the Next.js app
# and the Cloud Functions read and write different tenant roots, nothing errors,
# and the split is invisible until data appears to be missing.
#
# Unifying them is task T-118b, currently BLOCKED pending verification of the
# deployed values (ledger row LDG-09). Until then, set both or neither.
# Degradation when unset: both default to the same literal below, so a fresh
# local environment is consistent by accident rather than by construction.

NEXT_PUBLIC_APP_ID=kana-nihongo-master
NOTIFICATIONS_APP_ID=kana-nihongo-master


# --- Canonical site URL ------------------------------------------------------
# Feeds sitemap.xml, robots.txt, metadataBase, OpenGraph image URLs and every
# user-visible share link. Degradation when unset: silently falls back to
# http://localhost:3000 (lib/site.ts) — share links and crawler metadata then
# point at localhost in production. Nothing warns.
#
# The production origin is an OPEN decision (Q-2 / ledger row LDG-08); there is
# no correct value to fill in here yet.

NEXT_PUBLIC_SITE_URL=http://localhost:3000


# --- Local emulator switches -------------------------------------------------
# NEXT_PUBLIC_USE_FIREBASE_EMULATOR routes the client SDK at the local
# Auth/Firestore emulators. Double-gated: it is ignored unless NODE_ENV is also
# non-production, so it can never point a real deployment at localhost.
# Leave unset for normal development against a real project.
#
# FIRESTORE_EMULATOR_HOST / FIREBASE_AUTH_EMULATOR_HOST are set FOR you by
# `firebase emulators:exec` during `npm run test:emu`. Set them by hand only to
# point tooling at an already-running emulator.
#
# Note: the emulator suites need a JDK 21+ on PATH — the Firestore emulator is a
# JVM process and firebase-tools rejects older Java.

# NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099


# --- AI generation tuning (all optional) -------------------------------------
# Read in features/ai/config.ts. Every one has a working default, shown as the
# value below. Degradation when unset: none — defaults apply. Gemini access
# itself is brokered by Firebase AI Logic using the client config above, so
# there is no AI API key to set here and none should be added.

NEXT_PUBLIC_AI_MODEL_CARD=gemini-2.5-flash-lite
NEXT_PUBLIC_AI_MODEL_DECK=gemini-2.5-flash-lite
NEXT_PUBLIC_AI_TEMPERATURE=0.4
NEXT_PUBLIC_AI_TOP_P=0.9
NEXT_PUBLIC_AI_MAX_OUTPUT_TOKENS=2048
NEXT_PUBLIC_AI_MIN_DECK_CARDS=5
NEXT_PUBLIC_AI_MAX_DECK_CARDS=30


# --- Error tracking: Sentry (optional) ---------------------------------------
# Prod-gated AND value-gated: the SDK no-ops in dev/CI regardless, and no-ops in
# production too while the DSN is empty. Degradation when unset: the app runs
# normally and NO errors are reported anywhere — the most consequential silent
# gap in this file, because its absence looks identical to having no errors.
#
# SENTRY_DSN is the server-side DSN; NEXT_PUBLIC_SENTRY_DSN the browser one.
# SENTRY_AUTH_TOKEN only enables source-map upload at build time
# (next.config.ts disables sourcemaps when it is absent); stack traces stay
# minified without it.

# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=


# --- Product analytics: PostHog (optional) -----------------------------------
# Prod-gated and key-gated, same pattern as Sentry. Degradation when unset: no
# analytics events are captured, silently. Events are proxied first-party
# through /ingest (see proxy.ts) so they survive ad blockers.
# NEXT_PUBLIC_POSTHOG_UI_HOST defaults to https://us.posthog.com; set it only
# for an EU or self-hosted instance.

# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com


# =============================================================================
# Set by the runtime — do NOT put these in .env.local
#
#   NODE_ENV       Next.js sets it (development / production / test).
#   NEXT_RUNTIME   Next.js sets it per execution context (nodejs / edge).
#   CI             Set by the CI runner; tooling branches on it.
#   GCLOUD_PROJECT Set inside the Cloud Functions runtime and by the emulators.
#
# They appear in the code as `process.env.*` reads, which is why they are named
# here — so that grepping for a variable and finding no entry means the entry is
# genuinely missing, not that it was deliberately omitted.
# =============================================================================
