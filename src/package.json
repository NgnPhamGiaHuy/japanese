{
    "name": "src",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "test": "vitest run",
        "test:browser": "vitest run --config vitest.browser.config.ts",
        "test:emu": "firebase emulators:exec --only firestore,auth \"vitest run --config vitest.emu.config.ts\"",
        "test:functions": "npm --prefix functions run test:emu",
        "emulators:start": "firebase emulators:start --only firestore,auth",
        "emulators:start:all": "firebase emulators:start --only firestore,auth,functions,storage",
        "start": "next start",
        "lint": "eslint",
        "check:vocab": "node scripts/check-vocabulary-agreement.mjs",
        "prepare": "cd .. && husky src/.husky"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,css,md}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "@base-ui/react": "^1.6.0",
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@hookform/resolvers": "^5.4.0",
        "@sentry/nextjs": "^10.65.0",
        "@tanstack-query-firebase/react": "^2.1.1",
        "@tanstack/react-query": "^5.101.2",
        "@tanstack/react-table": "^8.21.3",
        "@tanstack/react-virtual": "^3.14.6",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "date-fns": "^4.1.0",
        "firebase": "^12.12.0",
        "firebase-admin": "^13.8.0",
        "fractional-indexing": "^4.0.0",
        "lucide-react": "^1.8.0",
        "motion": "^12.42.2",
        "next": "16.2.3",
        "next-intl": "^4.13.2",
        "next-safe-action": "^8.5.5",
        "posthog-js": "^1.402.3",
        "react": "19.2.4",
        "react-confetti": "^6.4.0",
        "react-day-picker": "^10.0.1",
        "react-dom": "19.2.4",
        "react-dropzone": "^17.0.0",
        "react-hook-form": "^7.81.0",
        "recharts": "^3.9.2",
        "server-only": "^0.0.1",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.5.0",
        "zod": "^4.3.6",
        "zustand": "^5.0.14"
    },
    "devDependencies": {
        "@firebase/rules-unit-testing": "^5.0.1",
        "@ianvs/prettier-plugin-sort-imports": "^4.4.1",
        "@playwright/test": "^1.61.1",
        "@tailwindcss/postcss": "^4",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@vitejs/plugin-react": "^6.0.3",
        "@vitest/browser": "^4.1.10",
        "@vitest/browser-playwright": "^4.1.10",
        "@vitest/coverage-v8": "^4.1.10",
        "eslint": "^9",
        "eslint-config-next": "16.2.3",
        "firebase-tools": "^15.24.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0",
        "msw": "^2.15.0",
        "playwright": "^1.61.1",
        "prettier": "^3.8.2",
